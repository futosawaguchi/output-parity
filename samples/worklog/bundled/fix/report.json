    "caseId": "case-c",
    "edit": {
      "file": "worklog.py",
      "oldText": "        try:\n            day = datetime.fromisoformat(entry[\"date\"])",
      "newText": "        s = entry[\"date\"]\n        try:\n            # 3.10 の fromisoformat が受け付けなかった形式（末尾Z・区切りなし等）は従来どおり飛ばす\n            if s.endswith(\"Z\") or s[4:5] != \"-\" or s[7:8] != \"-\" or not s[5:7].isdigit():\n                raise ValueError(s)\n            day = datetime.fromisoformat(s)"
    },
